+#[cfg(test)]
+mod ohos_leaf_tests {
+    use super::*;
+    fn manager() -> CertManager {
+        let key = KeyPair::generate().unwrap();
+        let mut params = CertificateParams::default();
+        params.is_ca = IsCa::Ca(BasicConstraints::Unconstrained);
+        let cert = params.self_signed(&key).unwrap();
+        CertManager::from_pem(&cert.pem(), &key.serialize_pem(), false).unwrap()
+    }
+    #[test]
+    fn ohos_leaf_matches_only_issued_current_host() {
+        let m = manager();
+        assert!(!m.matches_cached_leaf("example.com", &[1]));
+        assert!(m.cert_cache.read().is_empty());
+        m.get_server_config("EXAMPLE.com.").unwrap();
+        let leaf = m.cert_cache.read()["example.com"].leaf_der.clone();
+        assert!(m.matches_cached_leaf("example.com", &leaf));
+        assert!(m.matches_cached_leaf("EXAMPLE.COM.", &leaf));
+        assert!(!m.matches_cached_leaf("other.com", &leaf));
+        assert!(!m.matches_cached_leaf("example.com", m.ca_cert_der.as_ref()));
+        let mut corrupt = leaf.clone(); corrupt[0] ^= 1;
+        assert!(!m.matches_cached_leaf("example.com", &corrupt));
+        assert!(!manager().matches_cached_leaf("example.com", &leaf));
+        m.get_server_config("127.0.0.1").unwrap();
+        let ip_leaf = m.cert_cache.read()["127.0.0.1"].leaf_der.clone();
+        assert!(!m.matches_cached_leaf("127.0.0.1", &ip_leaf));
+    }
+    #[test]
+    fn ohos_leaf_rejects_expired_and_future_signed_leaves() {
+        let m = manager();
+        for offset in [-91, 1] {
+            let issued = time::OffsetDateTime::now_utc() + time::Duration::days(offset);
+            let entry = m.generate_cert_config("example.com", issued).unwrap();
+            let leaf = entry.leaf_der.clone();
+            m.cert_cache.write().insert("example.com".into(), entry);
+            assert!(!m.matches_cached_leaf("example.com", &leaf));
+        }
+    }
+    #[test]
+    fn ohos_leaf_dns_validation() {
+        for host in ["", ".", "example.com..", "-bad.com", "bad-.com", "a_b.com", "127.0.0.1", "::1", "é.com", "x/y", "a b", "a@b", "a:443"] {
+            assert!(canonical_dns_host(host).is_none(), "{host}");
+        }
+        assert!(canonical_dns_host(&"a".repeat(64)).is_none());
+    }
