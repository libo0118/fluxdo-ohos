+pub(crate) fn canonical_dns_host(host: &str) -> Option<String> {
+    let host = host.strip_suffix('.').unwrap_or(host);
+    if host.is_empty() || host.len() > 253 || !host.is_ascii()
+        || host.parse::<std::net::IpAddr>().is_ok() { return None; }
+    if host.split('.').any(|label| label.is_empty() || label.len() > 63
+        || label.starts_with('-') || label.ends_with('-')
+        || !label.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'-')) { return None; }
+    Some(host.to_ascii_lowercase())
+}
 
