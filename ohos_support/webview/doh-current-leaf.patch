+        let host = std::ffi::CString::new("example.com").unwrap();
+        let invalid = std::ffi::CString::new("127.0.0.1").unwrap();
+        let leaf = [1u8];
+        assert_eq!(doh_proxy_matches_current_leaf(std::ptr::null(), leaf.as_ptr(), 1), 0);
+        assert_eq!(doh_proxy_matches_current_leaf(host.as_ptr(), std::ptr::null(), 1), 0);
+        assert_eq!(doh_proxy_matches_current_leaf(host.as_ptr(), leaf.as_ptr(), 16385), 0);
+        assert_eq!(doh_proxy_matches_current_leaf(invalid.as_ptr(), leaf.as_ptr(), 1), 0);
+        doh_proxy_stop();
+        assert_eq!(doh_proxy_matches_current_leaf(host.as_ptr(), leaf.as_ptr(), 1), 0);
+    }
