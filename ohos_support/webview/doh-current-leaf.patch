+/// Match only the active proxy's previously issued certificate; never generate here.
+#[no_mangle]
+pub extern "C" fn doh_proxy_matches_current_leaf(host: *const c_char, leaf: *const u8, len: usize) -> c_int {
+    if host.is_null() || leaf.is_null() || len == 0 || len > 16 * 1024 { return 0; }
+    let Ok(host) = (unsafe { CStr::from_ptr(host) }).to_str() else { return 0; };
+    let Some(host) = crate::cert::canonical_dns_host(host) else { return 0; };
+    let leaf = unsafe { std::slice::from_raw_parts(leaf, len) };
+    get_runtime().block_on(async {
+        let guard = get_server_holder().read().await;
+        if PORT.load(std::sync::atomic::Ordering::SeqCst) <= 0 { return 0; }
+        guard.as_ref().is_some_and(|server| server.port().is_some_and(|p| p > 0)
+            && server.matches_cached_leaf(&host, leaf)) as c_int
+    })
+}
